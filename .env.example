# GEMINI_API_KEY: The single Gemini API key used for all AI summarization features.
# Automatically injected by AI Studio at runtime from user secrets.
# Set this single environment variable when deploying to Google Cloud Run.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
